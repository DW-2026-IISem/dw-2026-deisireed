<div class="mx-auto max-w-6xl space-y-4 p-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Nuevo pedido</h1>
    <a pButton routerLink="/pedidos" label="Volver" icon="pi pi-arrow-left" severity="secondary" text></a>
  </div>

  @if (error(); as message) {
    <p-message severity="error" [text]="message" />
  }

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <p-card header="Cliente, turno y canal">
        <div class="grid gap-4 md:grid-cols-3">
          <p-select
            [fluid]="true"
            [ngModel]="clientId()"
            (ngModelChange)="clientId.set($event)"
            [options]="clients()"
            optionLabel="nombre"
            optionValue="id"
            [filter]="true"
            placeholder="Cliente"
            [loading]="loading()"
          />
          <p-select
            [fluid]="true"
            [ngModel]="cashRegisterId()"
            (ngModelChange)="cashRegisterId.set($event)"
            [options]="cashRegisters()"
            optionLabel="nombre"
            optionValue="id"
            placeholder="Turno de caja"
            [loading]="loading()"
          />
          <p-select
            [fluid]="true"
            [ngModel]="channel()"
            (ngModelChange)="channel.set($event)"
            [options]="channels"
            optionLabel="label"
            optionValue="value"
          />
        </div>
      </p-card>

      <p-card header="Productos">
        <div class="grid items-end gap-3 md:grid-cols-12">
          <div class="md:col-span-5">
            <p-select
              [fluid]="true"
              inputId="order-product"
              [ngModel]="selectedProductId()"
              (ngModelChange)="selectedProductId.set($event)"
              [options]="products()"
              optionLabel="nombre"
              optionValue="id"
              [filter]="true"
              placeholder="Buscar producto"
            />
          </div>
          <div class="md:col-span-2">
            <p-inputnumber
              [fluid]="true"
              inputId="order-qty"
              [ngModel]="quantity()"
              (ngModelChange)="quantity.set($event ?? 1)"
              [min]="1"
              [showButtons]="true"
            />
          </div>
          <div class="md:col-span-3">
            <input
              pInputText
              class="w-full"
              placeholder="Observaciones (opcional)"
              [ngModel]="note()"
              (ngModelChange)="note.set($event)"
            />
          </div>
          <div class="md:col-span-2">
            <button pButton type="button" class="w-full" label="Agregar" icon="pi pi-plus" (click)="addLine()"></button>
          </div>
        </div>

        <div class="mt-4 overflow-x-auto">
          <p-table [value]="lines()" tableStyleClass="min-w-3xl">
            <ng-template #header>
              <tr>
                <th>Producto</th>
                <th class="text-right">Precio</th>
                <th class="text-right">Cantidad</th>
                <th>Observaciones</th>
                <th class="text-right">Total línea</th>
                <th class="w-12"></th>
              </tr>
            </ng-template>
            <ng-template #body let-line let-index="rowIndex">
              <tr>
                <td>{{ productById().get(line.producto_id)?.nombre || ('Producto #' + line.producto_id) }}</td>
                <td class="text-right">
                  {{ productById().get(line.producto_id)?.precio | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}
                </td>
                <td class="text-right">{{ line.cantidad }}</td>
                <td>{{ line.observaciones || '—' }}</td>
                <td class="text-right">{{ lineTotal(line) | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}</td>
                <td class="text-right">
                  <button pButton text rounded severity="danger" icon="pi pi-times" (click)="removeLine(index)"></button>
                </td>
              </tr>
            </ng-template>
            <ng-template #emptymessage>
              <tr><td colspan="6" class="text-center text-slate-500">Aún no hay líneas.</td></tr>
            </ng-template>
          </p-table>
        </div>
      </p-card>
    </div>

    <div>
      <p-card header="Resumen" styleClass="lg:sticky lg:top-4">
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-slate-500">Líneas</dt>
            <dd>{{ lines().length }}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-slate-500">Subtotal</dt>
            <dd class="font-medium">{{ subtotal() | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}</dd>
          </div>
          <div class="flex justify-between border-t border-slate-200 pt-2 text-base">
            <dt class="font-semibold">Total</dt>
            <dd class="font-semibold">{{ total() | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}</dd>
          </div>
        </dl>
        <button
          pButton
          type="button"
          class="mt-4 w-full"
          label="Registrar pedido"
          icon="pi pi-check"
          [loading]="saving()"
          [disabled]="saving() || loading()"
          (click)="save()"
        ></button>
      </p-card>
    </div>
  </div>
</div>
