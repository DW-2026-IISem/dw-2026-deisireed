<div class="mx-auto max-w-7xl space-y-4 p-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Panel</h1>
    <button pButton type="button" label="Recargar" icon="pi pi-refresh" severity="secondary" [loading]="loading()" (click)="load()"></button>
  </div>

  @if (error(); as message) {
    <p-message severity="error" [text]="message" />
  }

  @if (loading()) {
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      @for (i of [1, 2, 3, 4]; track i) {
        <p-skeleton height="6rem" borderRadius="1rem" />
      }
    </div>
  } @else {
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <p-card><div class="text-sm text-slate-500">Clientes</div><div class="text-3xl font-semibold">{{ clients().length }}</div></p-card>
      <p-card><div class="text-sm text-slate-500">Productos</div><div class="text-3xl font-semibold">{{ products().length }}</div></p-card>
      <p-card><div class="text-sm text-slate-500">Pedidos</div><div class="text-3xl font-semibold">{{ orders().length }}</div></p-card>
      <p-card><div class="text-sm text-slate-500">Ingresos (pagados)</div><div class="text-3xl font-semibold">{{ revenue() | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}</div></p-card>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <p-card header="Pedidos pendientes">
        <p-table [value]="pending()" tableStyleClass="min-w-md">
          <ng-template #header><tr><th>#</th><th>Cliente</th><th class="text-right">Total</th></tr></ng-template>
          <ng-template #body let-order>
            <tr>
              <td>{{ order.id }}</td>
              <td>{{ clientName()(order.cliente_id) }}</td>
              <td class="text-right">{{ order.total | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}</td>
            </tr>
          </ng-template>
          <ng-template #emptymessage><tr><td colspan="3" class="text-center text-slate-500">Nada pendiente.</td></tr></ng-template>
        </p-table>
      </p-card>

      <p-card header="Productos más pedidos">
        <p-table [value]="topProducts()" tableStyleClass="min-w-md">
          <ng-template #header><tr><th>Producto</th><th class="text-right">Unidades</th></tr></ng-template>
          <ng-template #body let-row>
            <tr><td>{{ productName()(row.producto_id) }}</td><td class="text-right">{{ row.cantidad }}</td></tr>
          </ng-template>
          <ng-template #emptymessage><tr><td colspan="2" class="text-center text-slate-500">Sin datos.</td></tr></ng-template>
        </p-table>
      </p-card>
    </div>

    <p-card>
      <ng-template #header>
        <div class="flex items-center justify-between px-4 pt-4">
          <span class="font-semibold">Últimos pedidos</span>
          <a pButton routerLink="/pedidos" label="Ver todos" text size="small"></a>
        </div>
      </ng-template>
      <p-table [value]="latestOrders()" tableStyleClass="min-w-xl">
        <ng-template #header><tr><th>#</th><th>Fecha</th><th>Cliente</th><th class="text-right">Total</th><th>Estado</th></tr></ng-template>
        <ng-template #body let-order>
          <tr>
            <td>{{ order.id }}</td>
            <td>{{ order.fecha | date: 'dd/MM/yyyy HH:mm' }}</td>
            <td>{{ clientName()(order.cliente_id) }}</td>
            <td class="text-right">{{ order.total | currency: 'COP' : 'symbol-narrow' : '1.0-0' }}</td>
            <td><p-tag [value]="stateLabel[order.estado]" [severity]="severity(order.estado)" /></td>
          </tr>
        </ng-template>
      </p-table>
    </p-card>
  }
</div>
