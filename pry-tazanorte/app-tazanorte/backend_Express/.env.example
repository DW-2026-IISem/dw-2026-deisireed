# Copia este archivo como `.env` y completa los valores. Nunca subas `.env` al repositorio.
PORT=4000

# Motor de base de datos (mysql | postgres)
DB_ENGINE=mysql

# MySQL (Docker)
MYSQL_HOST=127.0.0.1
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password
MYSQL_NAME=tazanorte_db
MYSQL_PORT=3306

# PostgreSQL (alternativo)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_NAME=tazanorte_db
POSTGRES_PORT=5432

# Fase II — Seguridad (JWT + RBAC)
# Secreto de firma del access token. Mínimo 32 caracteres: genera uno con `openssl rand -base64 48`.
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
# Vida útil del access token en segundos (900 = 15 min).
JWT_ACCESS_TTL=900
# Vida útil del refresh token en días.
JWT_REFRESH_TTL_DAYS=7
